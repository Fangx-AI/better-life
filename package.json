{
  "name": "better-life",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "人生工具箱：学校没教，生活会考。",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "node scripts/build.mjs && vite",
    "build": "node scripts/build.mjs && vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "api": "node --env-file-if-exists=.env.local server/index.mjs",
    "serve": "node --env-file-if-exists=.env.local server/app.mjs",
    "auth:status": "node scripts/auth-status.mjs",
    "production:preflight": "node --env-file-if-exists=.env.local scripts/production-preflight.mjs",
    "db:backup": "node --env-file-if-exists=.env.local scripts/membership-backup.mjs create",
    "db:restore-check": "node --env-file-if-exists=.env.local scripts/membership-backup.mjs check",
    "db:restore-new": "node --env-file-if-exists=.env.local scripts/membership-backup.mjs restore",
    "export:obsidian": "node scripts/obsidian.mjs",
    "check:qa-live": "node --env-file-if-exists=.env.local scripts/qa-live-check.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "check": "npm run build && npm test && node library/tools/check-plain.mjs && node library/tools/check-refs.mjs --check",
    "check:qa-conversation-live": "node --env-file-if-exists=.env.local scripts/qa-conversation-live-check.mjs"
  },
  "dependencies": {
    "@radix-ui/react-label": "2.1.15",
    "@tabler/icons-react": "3.48.0",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.1",
    "clsx": "2.1.1",
    "motion": "14.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "vite": "8.3.2"
  },
  "devDependencies": {
    "sharp": "0.35.5"
  }
}
