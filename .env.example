# 服务端专用：复制为 .env.local，在本机编辑，切勿提交或发送到聊天。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# 独立 API 正式部署时，填写实际前端 origin，多个以逗号分隔。
QA_ALLOWED_ORIGINS=https://fangx-ai.github.io,http://127.0.0.1:4173,http://127.0.0.1:4174
QA_HOST=127.0.0.1
QA_PORT=4175
# 只有公开 API 地址可以使用 VITE_ 前缀。留空则访问同源 /api/ask。
# GitHub Pages 部署时需填写独立 HTTPS 后端完整地址：
VITE_QA_API_URL=

# 会员、私人指南：以下全是服务端配置，不使用 VITE_ 前缀。
# 仅本机单实例原型使用 SQLite；正式收费主站需持久数据库/备份。
# 留空使用 output/private/membership.sqlite（不会打进静态包或提交 Git）。
MEMBERSHIP_DB_PATH=
# 本机 >=32；生产 >=48 字符的独立高熵秘密，用于验证码 HMAC 和私人数据 AES-GCM。
# 不能丢失/随意轮换，否则旧私人档案无法解密。不要发到聊天或写入日志。
MEMBERSHIP_AUTH_SECRET=
# 正式主站填写唯一同源 HTTPS origin，例如 https://your-owned-domain.example
# 本机可以留空；会员写操作禁止跨域，不能直接用 Pages 跨站 Cookie 收费。
MEMBERSHIP_APP_ORIGIN=
# 本机默认 false：不改变当前 DeepSeek 问答；生产必须 true，否则拒绝启动。
# 私人指南的继续问始终要求登录、核对本人档案和服务端额度。
MEMBERSHIP_ENFORCE=false
# 只为本机loopback体验显式开启，生产/远程客户端强制拒绝，不代表邮箱认证。
# 缺AUTH_SECRET时会在output/private/local-demo.key生成持久高熵key，禁止提交/分享。
MEMBERSHIP_LOCAL_DEMO=false
# 年度价格仅预览，未经成本验证不开放年付购买。
MEMBERSHIP_ANNUAL_ENABLED=false
# 邮箱发送需要自己的已验证 Resend 发件域；空值时登录真实返回 503。
# 支持复用阿里云：两项provider改为aliyun，只需配置下面五项阿里云变量。
MEMBERSHIP_EMAIL_PROVIDER=resend
MEMBERSHIP_SMS_PROVIDER=tencent
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_EMAIL_ACCOUNT_NAME=
RESEND_API_KEY=
MEMBERSHIP_EMAIL_FROM=
# 手机验证码：腾讯云短信，所有字段仅服务端使用，签名和模板须先审核通过。
# 默认大陆+86、6位验证码；模板1变量为验证码，2变量为验证码和有效分钟数(5)。
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou
TENCENT_SMS_TEMPLATE_PARAM_COUNT=1
# 只在使用临时STS凭据时填写，长期密钥留空。
TENCENT_SMS_TOKEN=
# 全站每天短信发送尝试上限；失败/超时也计入，防止充值被刷。
MEMBERSHIP_SMS_DAILY_LIMIT=100
# 只有自己管理的反向代理socket地址可列入，默认不信任代理头。
# 例：127.0.0.1,::1,::ffff:127.0.0.1；入口必须覆盖X-Real-IP为实际客户端IP。
MEMBERSHIP_TRUSTED_PROXY_IPS=
# 虎皮椒适配器已实现，付款默认关闭。仅服务端可配置；不读取其他项目回调地址/订单。
# 先确认商户允许本项目售卖及独立域名，再填写独立字段并完成真实验收后开新单。
# 停新单时保持provider与商户配置，以继续接收已有订单的验签支付/退款回调。
MEMBERSHIP_PAYMENT_PROVIDER=none
MEMBERSHIP_PAYMENT_CREATE_ENABLED=false
MEMBERSHIP_HUPIJIAO_APPID=
MEMBERSHIP_HUPIJIAO_APPSECRET=
# 生产SQLite全库备份加密，与AUTH_SECRET不同；32随机字节的base64url编码(43字符)。
# 不写入命令行/日志，不随意轮换；备份key与AUTH_SECRET分别做离线托管。
MEMBERSHIP_BACKUP_ENCRYPTION_KEY=
MEMBERSHIP_BACKUP_DIR=
# 只在人工恢复校验时设置：密文备份绝对路径；不会自动覆盖运行中数据库。
MEMBERSHIP_RESTORE_CHECK_FILE=
MEMBERSHIP_RESTORE_DESTINATION=
MEMBERSHIP_RESTORE_CONFIRM=

# 平台模型成本保护（必填生产配置）；使用当前实际模型/币种价格，不把假设当账单。
# 四项必须同时填写，日预算不得超过月预算；80%在受保护后台提示，满额拒绝新生成。
QA_BUDGET_DAILY_CNY=
QA_BUDGET_MONTHLY_CNY=
QA_PRICE_INPUT_CNY_PER_MILLION=
QA_PRICE_OUTPUT_CNY_PER_MILLION=

# 运营后台 /?view=operations，默认关闭；独立48随机字节base64url（64字符）。
# 不复用AUTH/备份/支付密钥，不放URL/浏览器存储；页面只显示脱敏订单与工单。
OPERATIONS_ENABLED=false
OPERATIONS_SECRET=
OPERATIONS_OPERATOR_ID=owner
# 真实客服入口的HTTPS URL。留空不展示虚构联系方式；退款工单仍可在账号内提交。
MEMBERSHIP_SUPPORT_URL=

# 第一方转化统计，两端均显式启用才接收；不用私人正文/账号标识/外部分析平台。
ANALYTICS_ENABLED=false
VITE_ANALYTICS_ENABLED=false
# 正式主站实际公开origin。未指定保留已公开GitHub Pages；预演请禁索引。
PUBLIC_SITE_ORIGIN=https://fangx-ai.github.io
PUBLIC_BASE_PATH=/better-life/
PUBLIC_INDEXING_ENABLED=true
